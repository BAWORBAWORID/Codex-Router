{
    "name": "Codex-Router",
    "version": "1.0.5-rc.3",
    "description": "High-performance multi-provider AI Gateway and LLM proxy router built with Hono, TypeScript, and SQLite WAL",
    "author": "ZelApi",
    "license": "MIT",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@12.5.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/BAWORBAWORID/Codex-Router.git"
    },
    "keywords": [
        "ai-gateway",
        "llm-proxy",
        "openai-compatible",
        "anthropic-compatible",
        "hono",
        "sqlite",
        "antigravity",
        "gemini",
        "claude",
        "chatgpt",
        "router"
    ],
    "homepage": "https://github.com/BAWORBAWORID/Codex-Router#readme",
    "bugs": {
        "url": "https://github.com/BAWORBAWORID/Codex-Router/issues"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "node_modules/.pnpm/@turbo+linux-64@2.11.3/node_modules/@turbo/linux-64/bin/turbo run dev",
        "dev:api": "node_modules/.pnpm/@turbo+linux-64@2.11.3/node_modules/@turbo/linux-64/bin/turbo run dev --filter=api",
        "dev:web": "node_modules/.pnpm/@turbo+linux-64@2.11.3/node_modules/@turbo/linux-64/bin/turbo run dev --filter=web",
        "start": "node_modules/.pnpm/@turbo+linux-64@2.11.3/node_modules/@turbo/linux-64/bin/turbo run start",
        "build": "node_modules/.pnpm/@turbo+linux-64@2.11.3/node_modules/@turbo/linux-64/bin/turbo run build",
        "build:api": "node_modules/.pnpm/@turbo+linux-64@2.11.3/node_modules/@turbo/linux-64/bin/turbo run build --filter=api",
        "build:web": "node_modules/.pnpm/@turbo+linux-64@2.11.3/node_modules/@turbo/linux-64/bin/turbo run build --filter=web",
        "clean": "turbo clean",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "node_modules/.pnpm/@turbo+linux-64@2.11.3/node_modules/@turbo/linux-64/bin/turbo run lint",
        "test": "node_modules/.pnpm/@turbo+linux-64@2.11.3/node_modules/@turbo/linux-64/bin/turbo run test"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "@xyflow/system": "^0.0.80",
        "turbo": "^2.11.2"
    },
    "devDependencies": {
        "csstype": "^3.1.0",
        "prettier": "^3.5.0",
        "typescript": "^5.8.3"
    }
}